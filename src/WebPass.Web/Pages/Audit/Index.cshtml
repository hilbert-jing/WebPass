@page "/audit"
@using WebPass.Web.Presentation
@model WebPass.Web.Pages.Audit.IndexModel
@{
    ViewData["Title"] = "审计日志";
}

<header class="page-header">
    <div>
        <h1>审计日志</h1>
        <p>查看安全与管理操作的时间、主体和处理结果。</p>
    </div>
</header>

<section class="toast-region" aria-label="审计日志使用说明">
    <strong>只读记录</strong>
    <p>审计日志为只读记录，不能在此修改或删除。</p>
</section>

<table class="data-table">
    <thead>
        <tr>
            <th>时间</th>
            <th>操作人</th>
            <th>动作</th>
            <th>对象</th>
            <th>结果</th>
            <th>关联编号</th>
        </tr>
    </thead>
    <tbody>
    @if (Model.Entries.Count == 0)
    {
        <tr>
            <td colspan="6">尚无审计记录</td>
        </tr>
    }
    else
    {
        @foreach (var entry in Model.Entries)
        {
            var correlationTarget = $"audit-correlation-{entry.Id:N}";
            var correlationStatus = $"audit-correlation-status-{entry.Id:N}";
            <tr>
                <td class="data-value">@entry.OccurredAt.ToString("yyyy-MM-dd HH:mm:ss zzz")</td>
                <td class="data-value">@(string.IsNullOrWhiteSpace(entry.ActorUsername)
                    ? entry.ActorUserId is { } actorUserId
                        ? $"未知用户（{actorUserId}）"
                        : "系统"
                    : entry.ActorUsername)</td>
                <td>@UiLabels.ForAuditAction(entry.Action)</td>
                <td>
                    @UiLabels.ForAuditObjectType(entry.ObjectType)
                    @if (!string.IsNullOrWhiteSpace(entry.ObjectId))
                    {
                        <span class="data-value">@entry.ObjectId</span>
                    }
                </td>
                <td>@UiLabels.ForAuditResult(entry.Result)</td>
                <td>
                    @if (string.IsNullOrWhiteSpace(entry.CorrelationId))
                    {
                        <span>无</span>
                    }
                    else
                    {
                        <span id="@correlationTarget" class="data-value">@entry.CorrelationId</span>
                        <button type="button"
                                data-copy
                                data-copy-target="#@correlationTarget"
                                data-copy-status-target="#@correlationStatus"
                                aria-describedby="@correlationStatus"
                                aria-label="复制关联编号">
                            复制
                        </button>
                        <span id="@correlationStatus"
                              role="status"
                              aria-live="polite"
                              aria-atomic="true"></span>
                    }
                </td>
            </tr>
        }
    }
    </tbody>
</table>
