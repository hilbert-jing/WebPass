@page "/admin/password-export"
@model WebPass.Web.Pages.Admin.PasswordExportModel
@{
    ViewData["Title"] = "Administrator password export";
}

<h1>Administrator password export</h1>
<p><strong>Warning:</strong> This XLSX workbook contains plaintext server passwords. Store and share it carefully.</p>
<p>Current-password reauthentication is required and remains valid for five minutes in this session.</p>
<div asp-validation-summary="ModelOnly"></div>
<form method="post" asp-page-handler="Download">
    <label asp-for="Query.Search"></label>
    <input asp-for="Query.Search" />

    <label asp-for="Query.SubnetId">Subnet ID</label>
    <input asp-for="Query.SubnetId" />

    <label asp-for="Query.Status"></label>
    <select asp-for="Query.Status">
        <option value="">All</option>
        <option value="Unknown">Unknown</option>
        <option value="Alive">Alive</option>
        <option value="Fault">Fault</option>
    </select>

    <button type="submit">Download password XLSX</button>
</form>
