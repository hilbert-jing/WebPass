@page "/admin/password-export"
@using WebPass.Web.Domain.Enums
@using WebPass.Web.Presentation
@model WebPass.Web.Pages.Admin.PasswordExportModel
@{
    ViewData["Title"] = "导出服务器密码";
}

<header class="page-header">
    <div>
        <h1>导出服务器密码</h1>
        <p>仅管理员可执行。提交后仍由服务器检查当前会话是否已完成二次验证。</p>
    </div>
</header>

<section class="risk-callout form-section" aria-labelledby="password-export-risk">
    <span class="status-badge" data-status="warning">高风险操作</span>
    <h2 id="password-export-risk">文件包含明文服务器密码</h2>
    <p>下载后请按敏感凭据管理，限制接收人，不要通过非受控渠道保存或共享。</p>
</section>

<section class="export-scope form-section" aria-label="导出说明">
    <h2>导出范围与格式</h2>
    <p>筛选范围：按搜索条件、网段与状态导出匹配的服务器。</p>
    <p><strong>固定格式：</strong>XLSX</p>
    <p>系统会记录密码导出审计；当前密码二次验证在本会话中五分钟内有效。</p>
</section>

@if (!ViewData.ModelState.IsValid)
{
    <p class="alert-region" role="alert">无法导出服务器密码：请检查筛选条件。</p>
}

<form method="post" asp-page-handler="Download" class="command-bar">
    <div>
        <label asp-for="Query.Search">搜索</label>
        <input asp-for="Query.Search" placeholder="IP、位置、计算机或系统" />
    </div>
    <div>
        <label asp-for="Query.SubnetId">网段 ID</label>
        <input asp-for="Query.SubnetId" placeholder="全部网段" />
    </div>
    <div>
        <label asp-for="Query.Status">状态</label>
        <select asp-for="Query.Status">
            <option value="">全部状态</option>
            @foreach (var status in Enum.GetValues<AliveStatus>())
            {
                <option value="@status">@UiLabels.ForAliveStatus(status)</option>
            }
        </select>
    </div>

    <button type="submit" data-submit-label="正在准备文件">确认并导出密码</button>
</form>
