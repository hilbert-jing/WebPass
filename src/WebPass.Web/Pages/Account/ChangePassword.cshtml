@page "/account/change-password"
@model WebPass.Web.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "修改登录密码";
}

<header class="page-header">
    <div>
        <h1>修改登录密码</h1>
        <p>验证当前密码后，为您的 WebPass 账号设置新密码。</p>
    </div>
</header>

<section class="form-section" aria-labelledby="change-password-heading">
    <h2 id="change-password-heading">密码信息</h2>
    <form method="post">
        <div asp-validation-summary="ModelOnly"></div>

        <label asp-for="Input.CurrentPassword">当前密码</label>
        <input asp-for="Input.CurrentPassword"
               type="password"
               autocomplete="current-password" />
        <span asp-validation-for="Input.CurrentPassword"></span>

        <label asp-for="Input.NewPassword">新密码</label>
        <input asp-for="Input.NewPassword"
               type="password"
               autocomplete="new-password" />
        <span asp-validation-for="Input.NewPassword"></span>

        <label asp-for="Input.NewPasswordConfirmation">确认新密码</label>
        <input asp-for="Input.NewPasswordConfirmation"
               type="password"
               autocomplete="new-password" />
        <span asp-validation-for="Input.NewPasswordConfirmation"></span>

        <button type="submit" data-submit-label="正在修改">修改密码</button>
    </form>
</section>
