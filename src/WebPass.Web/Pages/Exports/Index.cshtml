@page "/exports"
@using WebPass.Web.Domain.Enums
@using WebPass.Web.Presentation
@model WebPass.Web.Pages.Exports.IndexModel
@{
    ViewData["Title"] = "导出服务器数据";
}

<header class="page-header">
    <div>
        <h1>导出服务器数据</h1>
        <p>按当前筛选范围生成服务器资产清单，可下载为 CSV 或 XLSX。</p>
    </div>
</header>

<section class="export-scope toast-region" aria-label="导出安全说明">
    <strong>普通导出不包含服务器密码</strong>
    <p>文件仅包含资产与运行状态信息，可按内部数据管理规范保存和共享。</p>
    <p data-export-scope-summary>@Model.ScopeSummary</p>
</section>

@if (!ViewData.ModelState.IsValid)
{
    <p class="alert-region" role="alert">无法导出：请检查筛选条件和文件格式。</p>
}

<form method="post" asp-page-handler="Download" class="command-bar">
    <div>
        <label asp-for="Query.Search">搜索</label>
        <input asp-for="Query.Search" placeholder="IP、位置、计算机或系统" />
    </div>
    <div>
        <label asp-for="Query.SubnetId">网段 ID</label>
        <input asp-for="Query.SubnetId" placeholder="全部网段" />
    </div>
    <div>
        <label asp-for="Query.Status">状态</label>
        <select asp-for="Query.Status">
            <option value="">全部状态</option>
            @foreach (var status in Enum.GetValues<AliveStatus>())
            {
                <option value="@status">@UiLabels.ForAliveStatus(status)</option>
            }
        </select>
    </div>
    <div>
        <label asp-for="Format">文件格式</label>
        <select asp-for="Format" data-export-format>
            <option value="Csv">CSV</option>
            <option value="Xlsx">XLSX</option>
        </select>
    </div>

    <button type="submit"
            data-export-submit
            data-submit-label="正在准备文件">
        @Model.DownloadLabel
    </button>
</form>
