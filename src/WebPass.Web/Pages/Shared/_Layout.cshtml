@using System.Security.Claims
@using WebPass.Web.Application.Authorization
@using WebPass.Web.Infrastructure.Authorization
@inject PermissionAuthorizationHandler PermissionAuthorization
@{
    Guid userId = Guid.Empty;
    var hasUser = User.Identity?.IsAuthenticated == true &&
        Guid.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out userId);
    var canViewAssets = hasUser && await PermissionAuthorization.IsAllowedAsync(userId, PermissionCode.AssetView, Context.RequestAborted);
    var canManageSubnets = hasUser && await PermissionAuthorization.IsAllowedAsync(userId, PermissionCode.SubnetManage, Context.RequestAborted);
    var canImport = hasUser && await PermissionAuthorization.IsAllowedAsync(userId, PermissionCode.ImportData, Context.RequestAborted);
    var canExport = hasUser && await PermissionAuthorization.IsAllowedAsync(userId, PermissionCode.ExportData, Context.RequestAborted);
    var canViewAudit = hasUser && await PermissionAuthorization.IsAllowedAsync(userId, PermissionCode.AuditView, Context.RequestAborted);
    var isAdministrator = hasUser && await PermissionAuthorization.IsAdministratorAsync(userId, Context.RequestAborted);
    var isFocused = !hasUser ||
        string.Equals(ViewData["LayoutVariant"]?.ToString(), "Focused", StringComparison.OrdinalIgnoreCase);
    var pageTitle = ViewData["Title"]?.ToString() ?? "工作区";
    var hasBlockingErrors = ViewData.ModelState.ErrorCount > 0;
    var statusMessage = TempData["StatusMessage"] as string;

    bool IsCurrent(string path) =>
        Context.Request.Path.Equals(path) ||
        Context.Request.Path.StartsWithSegments($"{path}/");
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@pageTitle - WebPass</title>
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    @if (isFocused)
    {
        <div class="focused-shell">
            <header class="focused-brand">
                <a class="brand-mark" href="@(hasUser ? "/servers" : "/login")" aria-label="WebPass 首页">
                    <span class="brand-symbol" aria-hidden="true">W</span>
                    <span>
                        <strong>WebPass</strong>
                        <small>基础设施控制台</small>
                    </span>
                </a>
                <p>面向内网资产的精密、可审计工作台。</p>
            </header>
            <main id="main-content" class="focused-content" tabindex="-1">
                @if (!string.IsNullOrWhiteSpace(statusMessage))
                {
                    <div class="toast-region" role="status">@statusMessage</div>
                }
                @if (hasBlockingErrors)
                {
                    <div class="alert-region" role="alert">请检查表单中标记的错误后重试。</div>
                }
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <div class="app-shell">
            <aside class="app-sidebar" id="app-sidebar" data-drawer>
                <div class="sidebar-heading">
                    <a class="brand-mark" href="/servers" aria-label="WebPass 首页">
                        <span class="brand-symbol" aria-hidden="true">W</span>
                        <span class="brand-copy">
                            <strong>WebPass</strong>
                            <small>基础设施控制台</small>
                        </span>
                    </a>
                    <button class="sidebar-close" type="button" data-drawer-close data-drawer-initial-focus aria-label="关闭导航">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                            <path d="m6 6 12 12M18 6 6 18" />
                        </svg>
                    </button>
                </div>

                <nav class="primary-nav" aria-label="主要导航">
                    @if (canViewAssets || canManageSubnets)
                    {
                        <section class="nav-group" aria-labelledby="nav-assets">
                            <h2 id="nav-assets">资产作业</h2>
                            @if (canViewAssets)
                            {
                                <a href="/servers" aria-current="@(IsCurrent("/servers") ? "page" : null)">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                                        <rect x="4" y="4" width="16" height="6" rx="1" /><rect x="4" y="14" width="16" height="6" rx="1" />
                                        <path d="M8 7h.01M8 17h.01M12 7h5M12 17h5" />
                                    </svg>
                                    <span class="nav-label">服务器资产</span>
                                </a>
                            }
                            @if (canManageSubnets)
                            {
                                <a href="/subnets" aria-current="@(IsCurrent("/subnets") ? "page" : null)">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                                        <circle cx="5" cy="12" r="2" /><circle cx="19" cy="6" r="2" /><circle cx="19" cy="18" r="2" />
                                        <path d="m7 11 10-4M7 13l10 4" />
                                    </svg>
                                    <span class="nav-label">网段管理</span>
                                </a>
                            }
                        </section>
                    }
                    @if (canImport || canExport)
                    {
                        <section class="nav-group" aria-labelledby="nav-data">
                            <h2 id="nav-data">数据流转</h2>
                            @if (canImport)
                            {
                                <a href="/imports" aria-current="@(IsCurrent("/imports") ? "page" : null)">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                                        <path d="M12 4v11m0 0-4-4m4 4 4-4M5 19h14" />
                                    </svg>
                                    <span class="nav-label">数据导入</span>
                                </a>
                            }
                            @if (canExport)
                            {
                                <a href="/exports" aria-current="@(IsCurrent("/exports") ? "page" : null)">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                                        <path d="M12 16V5m0 0L8 9m4-4 4 4M5 19h14" />
                                    </svg>
                                    <span class="nav-label">数据导出</span>
                                </a>
                            }
                        </section>
                    }
                    @if (canViewAudit || isAdministrator)
                    {
                        <section class="nav-group" aria-labelledby="nav-security">
                            <h2 id="nav-security">安全治理</h2>
                            @if (canViewAudit)
                            {
                                <a href="/audit" aria-current="@(IsCurrent("/audit") ? "page" : null)">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                                        <path d="M6 3h12v18H6zM9 8h6M9 12h6M9 16h4" />
                                    </svg>
                                    <span class="nav-label">审计日志</span>
                                </a>
                            }
                            @if (isAdministrator)
                            {
                                <a href="/admin/users" aria-current="@(IsCurrent("/admin/users") ? "page" : null)">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                                        <circle cx="9" cy="8" r="3" /><path d="M3.5 19c.7-3.2 2.5-5 5.5-5s4.8 1.8 5.5 5M17 10v6m-3-3h6" />
                                    </svg>
                                    <span class="nav-label">用户与权限</span>
                                </a>
                                <a href="/admin/password-export" aria-current="@(IsCurrent("/admin/password-export") ? "page" : null)">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                                        <rect x="5" y="10" width="14" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3" />
                                    </svg>
                                    <span class="nav-label">密码导出</span>
                                </a>
                            }
                        </section>
                    }
                </nav>

                <div class="sidebar-account">
                    <span class="session-dot" aria-hidden="true"></span>
                    <span class="account-copy">
                        <strong>已认证会话</strong>
                        <small>内网连接</small>
                    </span>
                    <form class="sidebar-logout" method="post" asp-page="/Logout">
                        <button class="logout-button" type="submit">退出</button>
                    </form>
                </div>
            </aside>

            <div class="app-workspace">
                <header class="topbar">
                    <button class="nav-toggle" type="button" data-nav-toggle aria-controls="app-sidebar" aria-expanded="false">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                            <path d="M4 7h16M4 12h16M4 17h16" />
                        </svg>
                        <span>导航</span>
                    </button>
                    <div class="breadcrumb" aria-label="当前位置">
                        <span>WebPass</span>
                        <span aria-hidden="true">/</span>
                        <strong>@pageTitle</strong>
                    </div>
                    <div class="topbar-session">
                        <span class="session-dot" aria-hidden="true"></span>
                        <span>内网会话已连接</span>
                    </div>
                </header>
                <main id="main-content" class="app-content" tabindex="-1">
                    @if (!string.IsNullOrWhiteSpace(statusMessage))
                    {
                        <div class="toast-region" role="status">@statusMessage</div>
                    }
                    @if (hasBlockingErrors)
                    {
                        <div class="alert-region" role="alert">请检查表单中标记的错误后重试。</div>
                    }
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    <script src="/js/site.js" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
