@page "/servers/{id:guid?}/edit"
@model WebPass.Web.Pages.Servers.EditModel
@{
    ViewData["Title"] = "Edit server";
}

<h1>Edit server</h1>
<div asp-validation-summary="ModelOnly"></div>
@if (Model.AssetId is not null)
{
    <form method="post">
        <input type="hidden" name="id" value="@Model.AssetId" />
        <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
        <label asp-for="Input.BusinessIp"></label><input asp-for="Input.BusinessIp" />
        <label asp-for="Input.Location"></label><input asp-for="Input.Location" />
        <label asp-for="Input.AliveStatus"></label><select asp-for="Input.AliveStatus" asp-items="Html.GetEnumSelectList<WebPass.Web.Domain.Enums.AliveStatus>()"></select>
        <label asp-for="Input.ComputerName"></label><input asp-for="Input.ComputerName" />
        <label asp-for="Input.SystemName"></label><input asp-for="Input.SystemName" />
        <label asp-for="Input.OperatingSystemVersion"></label><input asp-for="Input.OperatingSystemVersion" />
        <label asp-for="Input.DatabaseVersion"></label><input asp-for="Input.DatabaseVersion" />
        <label asp-for="Input.Notes"></label><textarea asp-for="Input.Notes"></textarea>
        <button type="submit">Save server</button>
    </form>
}
else
{
    <p>Use the server inventory page to register @Model.Input.BusinessIp.</p>
}
