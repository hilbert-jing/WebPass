@page "/secrets/reauthenticate"
@model WebPass.Web.Pages.Secrets.ReauthenticateModel
@{
    ViewData["Title"] = "验证当前密码";
    ViewData["LayoutVariant"] = "Focused";
}

<section class="auth-panel" aria-labelledby="reauthenticate-title">
    <div class="auth-brand">敏感操作验证</div>
    <h1 id="reauthenticate-title">验证当前密码</h1>
    <p>验证通过后，可在当前会话中查看服务器密码 5 分钟。</p>
    <form method="post">
        <div asp-validation-summary="ModelOnly"></div>
        <input type="hidden" asp-for="ReturnUrl" />
        <label asp-for="Input.Password">当前密码</label>
        <input asp-for="Input.Password" autocomplete="current-password" />
        <button type="submit">验证</button>
    </form>
</section>
