@page "/secrets/reauthenticate"
@model WebPass.Web.Pages.Secrets.ReauthenticateModel
@{
    ViewData["Title"] = "Verify current password";
}

<h1>Verify current password</h1>
<p>This verification permits password viewing for five minutes in this signed-in session.</p>
<div asp-validation-summary="ModelOnly"></div>
<form method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <label asp-for="Input.Password"></label>
    <input asp-for="Input.Password" autocomplete="current-password" />
    <button type="submit">Verify</button>
</form>
